' Diagrama de Casos de Uso — cinco visões funcionais.
' Cada bloco @startuml/@enduml gera um diagrama independente.

@startuml UC01_Cadastro_Abertura
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase { BackgroundColor #EAF3F8; BorderColor #245B78; FontColor #173B53 }
skinparam actor { BorderColor #245B78; FontColor #173B53 }
title 01 — Cadastro e abertura
actor "Gerente" as G1
actor "Estoquista / Repositor(a)" as E1
rectangle "Sistema de Controle de Estoque para Lojas de Roupas" {
  usecase "UC01\nCadastrar produtos e variações" as UC01
  usecase "UC02\nConfigurar locais físicos" as UC02
  usecase "UC03\nRegistrar estoque inicial" as UC03
}
G1 -- UC01
G1 -- UC02
G1 -- UC03
E1 -- UC02
E1 -- UC03
@enduml

